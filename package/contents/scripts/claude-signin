#!/usr/bin/env -S fish --no-config
# Open a terminal running claude for one config directory, so an account whose
# token has expired can be signed back in.
#
# Claude Code prompts for a login when it starts without valid credentials, so
# there is nothing to automate beyond putting the user in front of it with
# $CLAUDE_CONFIG_DIR already pointed at the right account. The login itself is a
# browser round trip and cannot be done headlessly.
#
# The stock directory is the one value $CLAUDE_CONFIG_DIR must never be set to -
# Claude Code keeps that profile's state at ~/.claude.json rather than inside
# the directory - so it is launched without the variable instead.
#
# Usage: claude-signin <config-dir>
# Exit status is 0 when a terminal was launched.

set -l dir $argv[1]

if test -z "$dir"
    echo "usage: claude-signin <config-dir>" >&2
    exit 2
end

set dir (string replace -r '^~' $HOME -- $dir)
if not test -d $dir
    echo "no such config directory: $dir" >&2
    exit 1
end

if not command -q claude
    echo "claude is not on \$PATH" >&2
    exit 1
end

# xdg-terminal-exec is the freedesktop way to ask for the user's terminal and
# takes the command as plain arguments. The other two are the long-standing
# fallbacks, and both want -e.
set -l launcher
if command -q xdg-terminal-exec
    set launcher xdg-terminal-exec
else if command -q konsole
    set launcher konsole -e
else if command -q x-terminal-emulator
    set launcher x-terminal-emulator -e
else
    echo "no terminal emulator found (tried xdg-terminal-exec, konsole, x-terminal-emulator)" >&2
    exit 1
end

# Detached, so the widget's poll is not left waiting on a terminal the user may
# sit in for a minute.
if test "$dir" = "$HOME/.claude"
    $launcher claude </dev/null >/dev/null 2>&1 &
else
    CLAUDE_CONFIG_DIR=$dir $launcher claude </dev/null >/dev/null 2>&1 &
end
disown
