#!/usr/bin/env bash
# Look for Claude Code config directories under a path, one level down.
#
# There is no standard place to keep a second account: $CLAUDE_CONFIG_DIR takes
# any path, and the convention people land on is a sibling of the stock
# directory - ~/.claude-work, ~/.claude-personal - so the home directory is
# where this looks unless told otherwise.
#
# A path that is itself a config directory returns just itself, so the same
# script answers both "find the accounts under here" and "is this one an
# account?" - which is what the settings page needs to check a path typed by
# hand before it puts it in the list.
#
# Prints a JSON array of {dir, name}. The name is a first guess for the widget's
# list, which the user can rename; the directory is what identifies it.
#
# Usage: claude-find-profiles [path]

root=$HOME
[[ $# -gt 0 && -n $1 ]] && root=$1
[[ $root == '~'* ]] && root=$HOME${root:1}
# A trailing slash would make the home directory fail the comparison below.
while [[ $root == ?*/ ]]; do root=${root%/}; done

# Claude Code has written one of its own two files into every directory it
# owns. Both names are specific enough not to be anything else, and between them
# they cover a directory that has been logged into and one that has only been
# run.
__cfp_is_profile() {
    local dir=$1
    # Never the home directory itself. The stock profile keeps its .claude.json
    # *beside* ~/.claude rather than inside it, so home carries the marker
    # without being an account - and searching home, which is the default, would
    # otherwise turn up home.
    [[ $dir == "$HOME" ]] && return 1
    [[ -f $dir/.claude.json || -f $dir/.credentials.json ]]
}

candidates=()
if __cfp_is_profile "$root"; then
    candidates=("$root")
else
    mapfile -t entries < <(find "$root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
    for entry in "${entries[@]}"; do
        __cfp_is_profile "$entry" && candidates+=("$entry")
    done
fi

parts=()
for entry in "${candidates[@]}"; do
    # ".claude-personal" reads better as "personal" once it is sitting in a list
    # of accounts; the stock directory has nothing left after the same trim, and
    # "default" says what it is.
    name=$entry
    [[ $name == / ]] || name=${name##*/}
    name=${name#"${name%%[!.]*}"}
    trimmed=$name
    [[ $trimmed =~ ^claude[-_.]? ]] && trimmed=${trimmed:${#BASH_REMATCH[0]}}
    [[ -n $trimmed ]] && name=$trimmed
    [[ $entry == "$HOME/.claude" ]] && name=default

    parts+=("$(jq -n -c --arg dir "$entry" --arg name "$name" '{dir: $dir, name: $name}')")
done

if ((${#parts[@]} == 0)); then
    echo '[]'
else
    printf '%s\n' "${parts[@]}" | jq -s -c '.'
fi
