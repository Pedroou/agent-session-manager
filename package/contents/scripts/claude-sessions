#!/usr/bin/env bash
# Print one JSON document describing every agent session running right now:
# Claude Code, across every configured profile, and OMP (oh-my-pi).
#
# Claude Code keeps a registry of its own live sessions at
# <profile-dir>/sessions/<pid>.json, refreshed as the session changes state. The
# fields read here are `status` (one of busy/shell/idle/waiting), `waitingFor`,
# `needs`, `name`, `cwd` and `procStart`. Records are left behind when a session
# is killed rather than exiting cleanly, so every record is checked against /proc
# before it is reported: the process must still exist *and* its start time must
# match, which is what rules out a recycled pid.
#
# Two of the reported states are not in the registry at all and are worked out
# here (see __cs_running and __cs_error below):
#
#   running  a shell command or script is executing inside a busy session
#   error    an idle session whose last turn ended in an API error
#
# OMP keeps no registry at all, so its sessions are found the other way round:
# the process first, then the transcript it is writing, whose tail says what the
# session is doing (see the OMP section below).
#
# The widget polls this, so it stays cheap: record bodies and git metadata are
# read with bash builtins, and the whole batch is handed to a single jq. Only
# idle sessions pay for a transcript read, and only busy ones for a /proc walk.
# Each OMP session costs one `tail`, and all of them share one `realpath` and
# one more jq.
#
# The helpers below hand their answers back in global variables rather than on
# stdout: capturing a function's output with $(...) would fork a subshell for
# every session on every poll.
#
# Environment:
#   CLAUDE_PROFILES          JSON array of {name, dir} to read, in order
#   CLAUDE_SESSIONS_OMP      0 to leave OMP out entirely: no /proc scan, nothing
#                            read, nothing run. Anything else, or unset, reads it.
#   CLAUDE_SESSIONS_PROC     root to look for <pid>/... under, default /proc
#   CLAUDE_SESSIONS_NO_ERROR set to skip the transcript scan entirely
#
# Exit status is 0 whenever a document was printed, including "nothing running".

# An unmatched glob expands to nothing, rather than to itself.
shopt -s nullglob

if ! command -v jq >/dev/null 2>&1; then
    echo "Agent Session Manager needs jq. Install the jq package and it will pick it up on the next refresh." >&2
    exit 1
fi

# Ceilings, inherited by every process this starts. A run takes about 10 MB and
# a tenth of a CPU second, and still completes under a 128 MB address-space
# limit; these sit far above that, so they never bind on a run that is working,
# and stop one that is not - whatever it hit - long before the machine notices.
# Only ever lowered: a tighter limit already in force is kept, and a limit that
# cannot be set is simply not set.
__cs_cap() {
    local flag=$1 value=$2 now
    now=$(ulimit -S "$flag")
    if [[ $now == unlimited ]] || { [[ $now =~ ^[0-9]+$ ]] && ((now > value)); }; then
        ulimit -S "$flag" "$value" 2>/dev/null
    fi
}
__cs_cap -v 1048576 # 1 GiB of address space per process
__cs_cap -t 30 # 30 seconds of CPU per process

proc_root=/proc
[[ -n $CLAUDE_SESSIONS_PROC ]] && proc_root=$CLAUDE_SESSIONS_PROC

# Which config directories to read, and what to call each one.
#
# Claude Code's own mechanism for a second account is $CLAUDE_CONFIG_DIR, which
# takes any path at all - so there is no set of directories to hardcode, and the
# widget hands over the list the user configured. Derived per run, never cached
# at load time: the test suite moves $HOME.
profile_names=()
profile_dirs=()
if [[ -n $CLAUDE_PROFILES ]]; then
    # One jq, two lines per profile. Reading names and directories in separate
    # calls would double the only fork this parsing costs.
    mapfile -t flat < <(printf '%s\n' "$CLAUDE_PROFILES" | jq -r '.[] | (.name // ""), (.dir // "")' 2>/dev/null)
    for ((i = 0; i < ${#flat[@]}; i += 2)); do
        dir=${flat[i + 1]}
        [[ -n $dir ]] || continue
        [[ $dir == '~'* ]] && dir=$HOME${dir:1}
        profile_names+=("${flat[i]}")
        profile_dirs+=("$dir")
    done
fi
# Nothing configured: the directory Claude Code keeps its own account in, so
# running this by hand still shows something. Only that one - any other path is
# somebody's choice, and guessing at it is what this replaced.
# Only when nothing was handed over at all. An empty list is an answer - every
# account turned off, or the last one removed - and answering it with a
# directory nobody asked for is how "no accounts" became unreachable.
if ((${#profile_dirs[@]} == 0)) && [[ -z $CLAUDE_PROFILES ]]; then
    profile_names=(default)
    profile_dirs=("$HOME/.claude")
fi

# A path with its last component taken off, the way `dirname` does it - without
# the fork. Sets __cs_dir.
__cs_dirname() {
    local p=$1
    while [[ $p == */ && $p != / ]]; do p=${p%/}; done
    if [[ $p != */* ]]; then
        __cs_dir=.
        return
    fi
    p=${p%/*}
    while [[ $p == */ ]]; do p=${p%/}; done
    [[ -n $p ]] || p=/
    __cs_dir=$p
}

# A path's last component, the way `basename` does it. Sets __cs_base.
__cs_basename() {
    local p=$1
    while [[ $p == */ && $p != / ]]; do p=${p%/}; done
    [[ $p == / ]] || p=${p##*/}
    __cs_base=$p
}

# A string's words, split on blanks, into __cs_words. Globbing is held off while
# it splits, so a word like `*` stays a word.
__cs_split() {
    local IFS=$' \t\n'
    set -f
    # shellcheck disable=SC2206 # splitting is the point
    __cs_words=($1)
    set +f
}

# Field 22 of a /proc/<pid>/stat line: the process start time in clock ticks,
# which is exactly what Claude Code stores as `procStart`. Field 2 is the
# executable name in parentheses and may itself contain spaces or parens, so the
# fields are counted from after the *last* ')' - where field 22 overall becomes
# field 20. Sets __cs_field (empty when there is no such field).
__cs_stat_start() {
    __cs_split "${1##*)}"
    __cs_field=${__cs_words[19]}
}

# Is `pid` still the same process that wrote this record?
__cs_alive() {
    local proc_root=$1 pid=$2 want_start=$3
    local statfile=$proc_root/$pid/stat line=
    [[ -r $statfile ]] || return 1
    IFS= read -r -n 4096 line 2>/dev/null <"$statfile"
    [[ -n $line ]] || return 1
    if [[ -z $want_start ]]; then
        return 0 # older record with no start time recorded: existence is all we have
    fi
    __cs_stat_start "$line"
    [[ -n $__cs_field && $__cs_field == "$want_start" ]]
}

# Is a command running inside this session?
#
# Claude Code runs every Bash tool call as a direct child shell of its own
# process, so a child whose comm is a shell means "a command or script is
# executing". Its long-lived children are MCP servers (`npm exec …`, `node`),
# which are not shells, so the two never get confused. Subagents run inside the
# process and leave no trace here - they stay indistinguishable from thinking.
#
# Sets __cs_command to the command being run, when it can be recovered, and
# returns 1 when nothing is running.
__cs_running() {
    local proc_root=$1 pid=$2
    __cs_command=
    # The main thread is where Claude Code's forks are attributed, and reading one
    # file beats globbing the dozens of task/ entries a node process has.
    local children_file=$proc_root/$pid/task/$pid/children
    [[ -r $children_file ]] || return 1
    local -a kids=()
    read -r -a kids 2>/dev/null <"$children_file"
    ((${#kids[@]} > 0)) || return 1

    local kid comm part found shown
    local quote_dance="'\"'\"'" eval_tail="^(.*)' *<[^<]*\$"
    for kid in "${kids[@]}"; do
        comm=
        read -r -n 64 comm 2>/dev/null <"$proc_root/$kid/comm"
        case $comm in
        bash | sh | dash | zsh | fish | ksh) ;;
        *) continue ;;
        esac

        # Claude Code wraps each command as `… && eval '<command>' < /dev/null …`
        # after sourcing a shell snapshot. The eval'd text is the part worth
        # showing, taken up to the end of its first line. argv is NUL-separated,
        # and no one argument can be longer than the kernel's 128 KiB limit.
        shown=
        if [[ -r $proc_root/$kid/cmdline ]]; then
            while IFS= read -r -d '' -n 131072 part || [[ -n $part ]]; do
                [[ $part == *"eval '"* ]] || continue
                found=${part#*"eval '"}
                found=${found%%$'\n'*}
                [[ -n $found ]] || continue
                shown=$found
                [[ $shown =~ $eval_tail ]] && shown=${BASH_REMATCH[1]}
                # The command was single-quoted for eval, so its own quotes arrive
                # as the '"'"' dance. Undo that, then flatten it onto one line.
                shown=${shown//"$quote_dance"/"'"}
                shown=${shown//[$'\t\v\f\r']/ }
                __cs_split "$shown"
                shown="${__cs_words[*]}"
                break
            done 2>/dev/null <"$proc_root/$kid/cmdline"
        fi
        __cs_command=${shown:0:120}
        return 0
    done
    return 1
}

# A Claude Code session's transcript: <profile>/projects/<project>/<id>.jsonl.
# Sets __cs_cc_transcript, empty when there is none yet.
__cs_cc_transcript_of() {
    local profile_dir=$1 session_id=$2 t
    __cs_cc_transcript=
    [[ -n $session_id ]] || return
    for t in "$profile_dir"/projects/*/"$session_id".jsonl; do
        if [[ -f $t ]]; then
            __cs_cc_transcript=$t
            return
        fi
    done
}

# Did this session's last turn end in an API error?
#
# The registry has no error state - a session that fails goes back to `idle` -
# but the transcript records it, and unlike a live status the transcript is
# reliable here precisely because the session has stopped writing. The last
# assistant entry carries `isApiErrorMessage` and a message worth showing
# ("You've hit your session limit · resets 6:40pm", "Login expired · Please run
# /login"). Reading only the tail keeps the cost off the size of the file.
#
# Sets __cs_message to the message, and returns 1 when the last turn was fine.
__cs_error() {
    local transcript=$1
    __cs_message=
    [[ -n $transcript ]] || return 1
    [[ -z $CLAUDE_SESSIONS_NO_ERROR ]] || return 1

    local tail_text
    tail_text=$(tail -c 32768 -- "$transcript" 2>/dev/null)
    [[ $tail_text == *'"isApiErrorMessage":true'* ]] || return 1

    # `fromjson?` drops the partial first line a byte-offset tail leaves behind.
    # -s matters: without it jq runs the filter per line, and "the last assistant
    # entry" silently becomes "any line that is an error".
    local message
    message=$(printf '%s' "$tail_text" | jq -Rsr '
        [splits("\n") | fromjson? ]
        | map(select(.type == "assistant"))
        | last
        | select(.isApiErrorMessage == true)
        | (.message.content[0]?.text // "")
        | .[0:200]' 2>/dev/null)
    # Trimmed, and on one line.
    message=${message#"${message%%[![:space:]]*}"}
    message=${message%"${message##*[![:space:]]}"}

    [[ -n $message ]] || return 1
    __cs_message=${message//$'\n'/ }
}

# The git repository a session is sitting in, as "name" and "branch".
#
# Walks up for a .git rather than shelling out to git, which would be two more
# processes per session on every poll. Sets __cs_repo and __cs_branch (either
# may be empty).
__cs_git() {
    local dir=$1 root='' probe=$1 i line
    __cs_repo=
    __cs_branch=
    # Bounded so a pathological path can't spin, and absolute paths are shallow.
    for ((i = 0; i < 40; i++)); do
        [[ -n $probe ]] || break
        if [[ -e $probe/.git ]]; then
            root=$probe
            break
        fi
        __cs_dirname "$probe"
        [[ $__cs_dir == "$probe" ]] && break
        probe=$__cs_dir
    done

    [[ -n $root ]] || return 0

    # A worktree or submodule has .git as a file pointing at the real directory.
    local gitdir=$root/.git
    if [[ -f $gitdir ]]; then
        local pointer='' pointer_re='^gitdir:[[:space:]]*(.*)$'
        while IFS= read -r -n 4096 line || [[ -n $line ]]; do
            if [[ $line =~ $pointer_re ]]; then
                pointer=${BASH_REMATCH[1]}
                pointer=${pointer%"${pointer##*[![:space:]]}"}
                break
            fi
        done 2>/dev/null <"$gitdir"
        if [[ -n $pointer ]]; then
            [[ $pointer == /* ]] || pointer=$root/$pointer
            gitdir=$pointer
        fi
    fi

    if [[ -r $gitdir/HEAD ]]; then
        local head=
        read -r -n 4096 head 2>/dev/null <"$gitdir/HEAD"
        if [[ $head =~ ^ref:\ refs/heads/(.*)$ ]]; then
            __cs_branch=${BASH_REMATCH[1]}
        fi
        if [[ -z $__cs_branch ]]; then
            # Detached: show the short sha, which is what git itself would.
            [[ $head =~ ^[0123456789abcdef]{7,40}$ ]] && __cs_branch=${head:0:7}
        fi
    fi

    __cs_basename "$root"
    __cs_repo=$__cs_base
}

# ─── OMP ────────────────────────────────────────────────────────────────────
#
# OMP writes no registry of live sessions, but every running session is a
# process, and that process holds its transcript open for as long as it writes
# to it. So the process table says which sessions are alive, its fd table says
# which transcript each one is, and the tail of that transcript says what it is
# doing - all three from files, like everything else here.

# Every OMP session process, in ascending pid order, into __cs_omp_pid_list. The
# compiled binary runs as `omp`; an install run through bun or node shows that
# runtime's name with omp's script as the first argument. OMP's own helper
# processes (`omp __omp_worker_…`) share the name, and are dropped - none of
# them is a session.
#
# Every read has a ceiling (`read -n`), so no file - a process's argv, a
# breadcrumb, a transcript with no newline in it - can make this hold more than
# a few kilobytes of it in memory. And every read has its errors discarded: a
# process can exit between the glob and the read.
#
# This walks every process on the machine, so it sticks to glob tests: a bash
# regex is compiled afresh each time it is matched.
__cs_omp_pids() {
    local proc_root=$1 entry pid comm a0 a1 a2
    local -a by_pid=()
    __cs_omp_pid_list=()
    # Indexing a sparse array by pid sorts them numerically for free.
    for entry in "$proc_root"/[1-9]*; do
        pid=${entry##*/}
        [[ $pid == *[!0-9]* ]] || by_pid[pid]=1
    done
    for pid in "${!by_pid[@]}"; do
        comm=
        IFS= read -r -n 64 comm 2>/dev/null <"$proc_root/$pid/comm"
        case $comm in
        omp | bun | node) ;;
        *) continue ;;
        esac
        # The first three arguments are all that is looked at: the helper's
        # marker comes first for the binary, second through bun or node.
        a0='' a1='' a2=''
        [[ -r $proc_root/$pid/cmdline ]] || continue
        {
            IFS= read -r -d '' -n 4096 a0
            IFS= read -r -d '' -n 4096 a1
            IFS= read -r -d '' -n 4096 a2
        } 2>/dev/null <"$proc_root/$pid/cmdline"
        [[ -n $a0 ]] || continue
        [[ $a1 == __omp_* || $a2 == __omp_* ]] && continue
        if [[ $comm != omp ]]; then
            [[ $a1 =~ (^|/)omp$|/pi-coding-agent/ ]] || continue
        fi
        __cs_omp_pid_list+=("$pid")
    done
}

# Only a file named the way OMP names a session's transcript is ever read as
# one: <timestamp>_<session-id>.jsonl, and a regular file at that.
__cs_omp_is_transcript() {
    [[ $1 == */*.jsonl && $1 =~ /[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9-]+Z_[^/]+\.jsonl$ ]]
}

# Of these existing files, the one modified last - the first of them, on a tie.
# One `stat` for the lot, and none at all when there is only one. Sets
# __cs_newest.
__cs_newest_of() {
    __cs_newest=$1
    (($# > 1)) || return 0
    local -a mtimes
    mapfile -t mtimes < <(stat -c %Y -- "$@" 2>/dev/null)
    local i best_mtime=0
    __cs_newest=
    for ((i = 0; i < $#; i++)); do
        [[ ${mtimes[i]} =~ ^[0-9]+$ ]] || continue
        if [[ -z $__cs_newest ]] || ((mtimes[i] > best_mtime)); then
            __cs_newest=${*:i+1:1}
            best_mtime=${mtimes[i]}
        fi
    done
}

# Every path a session's transcript is looked for through - each process's
# working directory and open fds - resolved by one `realpath` for all of them,
# rather than one per session. -m gives one answer per path whether or not it
# leads anywhere, so they stay paired by position; should they not, each path is
# asked about on its own. Fills __cs_resolved, keyed by path.
declare -A __cs_resolved=()
__cs_resolve_all() {
    local proc_root=$1 pid i
    shift
    local -a paths=() out=()
    for pid; do
        paths+=("$proc_root/$pid/cwd" "$proc_root/$pid/fd/"*)
    done
    mapfile -t -d '' out < <(realpath -m -z -- "${paths[@]}" 2>/dev/null)
    if ((${#out[@]} != ${#paths[@]})); then
        out=()
        for i in "${!paths[@]}"; do
            out[i]=$(realpath -m -- "${paths[i]}" 2>/dev/null)
        done
    fi
    for i in "${!paths[@]}"; do
        __cs_resolved[${paths[i]}]=${out[i]}
    done
}

# The transcript an OMP process belongs to, as a path in __cs_transcript - which
# may not exist yet, for a session nobody has typed into. Also sets __cs_cwd to
# the process's working directory. Both come out of __cs_resolved.
#
# First choice is the one it has open. A session's transcript is named
# <timestamp>_<session-id>.jsonl; a subagent's, which the same process also
# holds open, is named after the agent - so the name alone tells them apart.
#
# A session OMP has not written yet holds nothing open, and nor does one that
# was resumed and has not written since. For those there is the breadcrumb OMP
# leaves per terminal, which is how its own `--continue` knows what was last
# open there: <agent-dir>/terminal-sessions/<tty>, holding the cwd and the
# transcript path. It is trusted only when its cwd is the process's own, since a
# terminal outlives the sessions run in it.
__cs_omp_transcript() {
    local proc_root=$1 pid=$2
    __cs_transcript=
    __cs_cwd=${__cs_resolved[$proc_root/$pid/cwd]}

    # In fd order, numerically, which a plain glob would not give.
    local f fd
    local -a by_fd=() others=() candidates=()
    for f in "$proc_root/$pid/fd/"*; do
        fd=${f##*/}
        if [[ $fd == 0 || ($fd == [1-9]* && $fd != *[!0-9]*) ]]; then
            by_fd[fd]=$f
        else
            others+=("$f")
        fi
    done
    for f in "${by_fd[@]}" "${others[@]}"; do
        f=${__cs_resolved[$f]}
        __cs_omp_is_transcript "$f" && [[ -f $f ]] && candidates+=("$f")
    done
    if ((${#candidates[@]} > 0)); then
        __cs_newest_of "${candidates[@]}"
        __cs_transcript=$__cs_newest
        [[ -n $__cs_transcript ]] && return 0
    fi

    # OMP names a terminal after its tty, /dev/pts/4 becoming pts-4. Only
    # `readlink` itself here: `realpath` would chase a link it cannot follow.
    local tty
    tty=$(readlink -- "$proc_root/$pid/fd/0" 2>/dev/null)
    [[ $tty =~ ^/dev/. ]] || return 1
    local terminal=${tty:5}
    terminal=${terminal//\//-}
    local crumb crumb_cwd crumb_file
    local -a crumbs=() crumb_files=()
    for crumb in "$HOME/.omp/agent/terminal-sessions/$terminal" \
        "$HOME"/.omp/profiles/*/agent/terminal-sessions/"$terminal"; do
        [[ -f $crumb ]] || continue
        crumb_cwd='' crumb_file=''
        {
            IFS= read -r -n 4096 crumb_cwd
            IFS= read -r -n 4096 crumb_file
        } 2>/dev/null <"$crumb"
        [[ $crumb_cwd == "$__cs_cwd" ]] || continue
        __cs_omp_is_transcript "$crumb_file" || continue
        crumbs+=("$crumb")
        crumb_files+=("$crumb_file")
    done
    ((${#crumbs[@]} > 0)) || return 1
    __cs_newest_of "${crumbs[@]}"
    local i
    for i in "${!crumbs[@]}"; do
        if [[ ${crumbs[i]} == "$__cs_newest" ]]; then
            __cs_transcript=${crumb_files[i]}
            break
        fi
    done
    [[ -n $__cs_transcript ]]
}

# When a process started, in clock ticks since boot: field 22 of its stat, which
# is also what Claude Code records as `procStart` (see __cs_stat_start). Sets
# __cs_ticks, and returns 1 when the process is gone.
__cs_start_ticks() {
    local proc_root=$1 pid=$2 line=
    __cs_ticks=
    [[ -r $proc_root/$pid/stat ]] || return 1
    IFS= read -r -n 4096 line 2>/dev/null <"$proc_root/$pid/stat"
    __cs_stat_start "$line"
    [[ $__cs_field =~ ^[0-9]+$ ]] || return 1
    __cs_ticks=$__cs_field
}

bodies=()
extras=() # seven per entry in $bodies, in step with it: the fields worked out here
present=()
cc_transcripts=() # one per Claude Code entry in $bodies: its transcript, or ""

re_proc_start='"procStart"[[:space:]]*:[[:space:]]*"([^"]*)"'
re_status='"status"[[:space:]]*:[[:space:]]*"([^"]*)"'
re_session_id='"sessionId"[[:space:]]*:[[:space:]]*"([^"]*)"'
re_cwd='"cwd"[[:space:]]*:[[:space:]]*"([^"]*)"'

for i in "${!profile_dirs[@]}"; do
    id=${profile_names[i]}
    dir=${profile_dirs[i]}
    # The stock directory is the one place $CLAUDE_CONFIG_DIR must never be set
    # to, so a session from it gets a plain `claude --resume`.
    is_default=false
    [[ $dir == "$HOME/.claude" ]] && is_default=true
    [[ -d $dir ]] && present+=("$id")

    # Records in pid order, numerically. A name with a leading zero is never a
    # live pid, since /proc has none.
    records=()
    for record in "$dir"/sessions/*.json; do
        pid=${record##*/}
        pid=${pid%.json}
        [[ $pid =~ ^[1-9][0-9]*$ ]] && records[pid]=$record
    done

    for pid in "${!records[@]}"; do
        record=${records[pid]}
        [[ -f $record ]] || continue

        # A torn record - Claude Code rewriting the file while this reads it - is
        # not valid JSON, and would fail the whole batch. Requiring a complete
        # object drops just that one record and keeps the rest of the panel.
        # Trimmed, with any line breaks turned into spaces, which JSON allows.
        body=
        IFS= read -r -d '' body 2>/dev/null <"$record"
        body=${body#"${body%%[![:space:]]*}"}
        body=${body%"${body##*[![:space:]]}"}
        body=${body//$'\n'/ }
        [[ $body == \{*\} ]] || continue

        want_start=
        [[ $body =~ $re_proc_start ]] && want_start=${BASH_REMATCH[1]}
        __cs_alive "$proc_root" "$pid" "$want_start" || continue

        status_now='' session_id='' cwd=''
        [[ $body =~ $re_status ]] && status_now=${BASH_REMATCH[1]}
        [[ $body =~ $re_session_id ]] && session_id=${BASH_REMATCH[1]}
        [[ $body =~ $re_cwd ]] && cwd=${BASH_REMATCH[1]}

        __cs_cc_transcript_of "$dir" "$session_id"

        # Only busy sessions can be running a command, and only idle ones can be
        # sitting on a failed turn - so neither check runs where it can't apply.
        overlay=
        detail=
        if [[ $status_now == busy ]]; then
            if __cs_running "$proc_root" "$pid"; then
                overlay=running
                detail=$__cs_command
            fi
        elif [[ $status_now == idle ]]; then
            if __cs_error "$__cs_cc_transcript"; then
                overlay=error
                detail=$__cs_message
            fi
        fi

        __cs_git "$cwd"

        bodies+=("$body")
        cc_transcripts+=("$__cs_cc_transcript")
        # Every value carries a leading ":" because jq still reads an argument
        # beginning with "-" as an option, even after --args - and a command line
        # or an error message can quite reasonably start with one. jq strips it.
        extras+=(":$id" ":$overlay" ":$detail" ":$__cs_repo" ":$__cs_branch"
            ":$dir" ":$is_default")
    done
done

# The model each Claude Code session is on, and how much of its context the last
# turn used: both on the newest assistant entry of the main thread, which
# carries the model id and the request's token counts. A subagent's entries and
# the ones Claude Code writes itself (model "<synthetic>", for an API error) say
# nothing about the session's own context, so they are passed over.
#
# `tac` reads a transcript from its end and grep stops at the fourth assistant
# line, so the cost does not grow with the length of the conversation; all the
# sessions then share one jq. The answers come back as a JSON array in the
# order of $bodies, with null for any entry that is not a Claude Code session.
contexts_json='[]'
if ((${#cc_transcripts[@]} > 0)); then
    mapfile -t cc_contexts < <(
        for t in "${cc_transcripts[@]}"; do
            printf '\x1e\n'
            [[ -n $t ]] || continue
            tac -- "$t" 2>/dev/null | grep -a -m 4 -F '"type":"assistant"'
        done | jq -ncR '
            reduce inputs as $line ([];
                if $line == "\u001e" then . + [[]] else .[-1] += [$line] end)
            | .[]
            | ([.[] | try fromjson catch null | objects
                | select(.type == "assistant" and .isSidechain != true
                         and (.message.usage | type) == "object"
                         and ((.message.model // "") | startswith("<") | not))]
               | first) as $m
            | if $m == null then null else
                {model: ($m.message.model // ""),
                 contextTokens: (($m.message.usage.input_tokens // 0)
                                 + ($m.message.usage.cache_creation_input_tokens // 0)
                                 + ($m.message.usage.cache_read_input_tokens // 0))}
              end' 2>/dev/null)
    # Paired by position, so a jq that fell over halfway leaves every session
    # without one rather than shifting them onto the wrong sessions.
    if ((${#cc_contexts[@]} == ${#cc_transcripts[@]})); then
        printf -v joined '%s,' "${cc_contexts[@]}"
        contexts_json="[${joined%,}]"
    fi
fi

# OMP sessions join the same two lists, so they sort and count with the rest.
# Each transcript's tail becomes a registry-shaped record - `status` one of
# busy/idle/waiting/running/error, the reason in `detail` - so from here on a
# session is a session, whichever agent runs it.
#
# Switched off, none of this runs: not the /proc scan, not a read, not a
# process. Switched on, its cost has a ceiling whatever the machine is doing:
# at most 32 sessions, and per session one `tail` of at most 128 KiB plus a
# first line of at most 4 KiB - so the one jq they share never sees more than
# about 4 MiB. A command that cannot start, for want of memory or processes or
# anything else, costs the OMP rows of that one refresh and nothing more:
# nothing is retried, nothing is written, and the Claude Code rows still print.
__cs_omp_pid_list=()
[[ $CLAUDE_SESSIONS_OMP != 0 ]] && __cs_omp_pids "$proc_root"
omp_max=32
omp_pids=("${__cs_omp_pid_list[@]:0:omp_max}")
if ((${#omp_pids[@]} > 0)); then
    btime=
    __cs_resolve_all "$proc_root" "${omp_pids[@]}"
    if [[ -r $proc_root/stat ]]; then
        while IFS= read -r line; do
            if [[ $line == 'btime '* && $line =~ ^btime\ ([0-9]+)$ ]]; then
                btime=${BASH_REMATCH[1]}
                break
            fi
        done 2>/dev/null <"$proc_root/stat"
    fi
    script_dir=${BASH_SOURCE[0]%/*}
    [[ $script_dir == "${BASH_SOURCE[0]}" ]] && script_dir=.
    omp_program=$script_dir/omp-sessions.jq

    omp_files=()
    omp_meta=() # seven per session, in the order the jq below reads them
    omp_extras=()
    for pid in "${omp_pids[@]}"; do
        # Gone since the scan: nothing to report, and nothing to end later.
        __cs_start_ticks "$proc_root" "$pid" || continue
        ticks=$__cs_ticks
        __cs_omp_transcript "$proc_root" "$pid" || continue
        cwd=$__cs_cwd
        file=$__cs_transcript
        session_id=
        [[ $file =~ _([^_/]+)\.jsonl$ ]] && session_id=${BASH_REMATCH[1]}

        # Transcripts live at <agent-dir>/sessions/<project>/<file>, unless
        # --session-dir put them somewhere else - in which case the directory
        # holding the file is all there is to say about where it came from.
        __cs_dirname "$file"
        file_dir=$__cs_dir
        __cs_dirname "$file_dir"
        sessions_dir=$__cs_dir
        __cs_dirname "$sessions_dir"
        agent_dir=$__cs_dir
        __cs_basename "$sessions_dir"
        [[ $__cs_base == sessions ]] || agent_dir=$file_dir

        # The stock agent directory resumes with a plain `omp --resume`, and a
        # named profile (`omp --profile <name>`) lives under ~/.omp/profiles.
        label=OMP
        omp_profile=
        is_default=false
        if [[ $agent_dir == "$HOME/.omp/agent" ]]; then
            is_default=true
        elif [[ $agent_dir == "$HOME/.omp/profiles/"* &&
            ${agent_dir#"$HOME/.omp/profiles/"} =~ ^([^/]+)/agent$ ]]; then
            omp_profile=${BASH_REMATCH[1]}
            label="OMP $omp_profile"
        fi

        # Epoch milliseconds: /proc/stat has the boot time, and USER_HZ is 100
        # on every architecture Linux exposes to userspace, so a tick is 10 ms.
        started=0
        [[ -n $btime ]] && started=$(((btime * 100 + ticks) * 10))

        __cs_git "$cwd"

        omp_files+=("$file")
        omp_meta+=(":$pid" ":$session_id" ":$cwd" ":$started" ":$file"
            ":$omp_profile" ":$ticks")
        omp_extras+=(":$label" ":" ":" ":$__cs_repo" ":$__cs_branch"
            ":$agent_dir" ":$is_default")
    done

    # One stream for every session, read by omp-sessions.jq beside this script:
    # a record separator opens each, then the transcript's first line - the
    # title, kept in a fixed-width slot OMP rewrites in place - then its tail.
    # A separator cannot occur inside JSON text, so it is never mistaken for a
    # line of transcript.
    records=()
    if ((${#omp_files[@]} > 0)); then
        mapfile -t records < <(
            for f in "${omp_files[@]}"; do
                printf '\x1e\n'
                [[ -f $f ]] || continue
                first=
                IFS= read -r -n 4096 first 2>/dev/null <"$f"
                printf '%s\n' "$first"
                tail -c 131072 -- "$f" 2>/dev/null
                echo
            done | jq -ncR -f "$omp_program" --args "${omp_meta[@]}" 2>/dev/null)
    fi

    # One record per session or none at all: the lists are paired by position,
    # so a jq that fell over halfway must not shift every record after it.
    if ((${#records[@]} == ${#omp_files[@]})); then
        bodies+=("${records[@]}")
        extras+=("${omp_extras[@]}")
    fi
fi

# Seconds with three zeros appended is a millisecond stamp, without relying on
# `date +%N`, which uutils coreutils - the default on this distro - does not
# accept a width for.
now=$(date +%s)000

present_json='[]'
if ((${#present[@]} > 0)); then
    printf -v joined '%s","' "${present[@]}"
    present_json='["'${joined%'","'}'"]'
fi

# Record bodies arrive on stdin, one JSON object per record, in the same order as
# $extras and $contexts - so a record's position is enough to pair it with what
# was worked out for it above.
printf '%s\n' "${bodies[@]}" | jq -n \
    --argjson now "$now" \
    --argjson contexts "$contexts_json" \
    --argjson profiles "$present_json" '
    def statusLabel($s):
        {waiting: "Waiting", running: "Running", busy: "Working",
         shell: "Shell", idle: "Done", error: "Error"}[$s]
        // (if ($s | length) > 0 then ($s[0:1] | ascii_upcase) + $s[1:] else "Unknown" end);
    def statusState($s):
        {waiting: "waiting", running: "running", busy: "working",
         shell: "shell", idle: "done", error: "error"}[$s] // "unknown";
    def rank($st):
        {waiting: 0, error: 1, running: 2, working: 3, shell: 4, done: 5}[$st] // 6;

    # Seven positional arguments per session, in the order the records were
    # read, each with the sentinel ":" the caller prefixed.
    def arg($i): ($ARGS.positional[$i] // ":") | .[1:];
    def extras($i): {
        profile:      (arg($i * 7)     | if . == "" then "work" else . end),
        overlay:       arg($i * 7 + 1),
        overlayDetail: arg($i * 7 + 2),
        repository:    arg($i * 7 + 3),
        branch:        arg($i * 7 + 4),
        profileDir:    arg($i * 7 + 5),
        profileDefault: (arg($i * 7 + 6) == "true")
    };

    [inputs] | to_entries | map(
        .value as $r
        | extras(.key) as $x
        | ($contexts[.key] // {}) as $c
        # The two states worked out from /proc and the transcript stand in for the
        # registry status; everything downstream treats them alike.
        | (if ($x.overlay // "") != "" then $x.overlay else ($r.status // "") end) as $status
        | statusState($status) as $state
        | (($r.cwd // "") | split("/") | map(select(. != ""))) as $parts
        | {
            pid:             ($r.pid // 0),
            # Which tool runs the session, and with it how the session is
            # resumed: OMP records carry the transcript and named profile that
            # its resume command needs; Claude Code needs neither.
            agent:           ($r.agent // "claude"),
            sessionFile:     ($r.sessionFile // ""),
            ompProfile:      ($r.ompProfile // ""),
            # When the process started, in clock ticks since boot. Ending a
            # session checks it again first, so a pid that has since been
            # handed to some other process is never signalled.
            procStart:       (($r.procStart // "") | tostring),
            profile:         ($x.profile // "work"),
            profileDir:      ($x.profileDir // ""),
            profileDefault:  $x.profileDefault,
            name:            ($r.name // $parts[-1] // "session"),
            cwd:             ($r.cwd // ""),
            dir:             ($parts[-1] // "/"),
            repository:      ($x.repository // ""),
            branch:          ($x.branch // ""),
            sessionId:       ($r.sessionId // ""),
            kind:            ($r.kind // "interactive"),
            status:          $status,
            state:           $state,
            label:           statusLabel($status),
            detail:          (if ($x.overlayDetail // "") != "" then $x.overlayDetail
                              else ($r.needs // $r.waitingFor // $r.detail // "") end),
            startedAt:       ($r.startedAt // 0),
            statusUpdatedAt: ($r.statusUpdatedAt // $r.updatedAt // 0),
            version:         ($r.version // ""),
            # The model as its id, and the tokens the last request carried; the
            # widget turns those into a name and a share of the context window.
            # OMP records bring their own, Claude Code ones come from $contexts.
            model:           ($r.model // $c.model // ""),
            contextTokens:   ($r.contextTokens // $c.contextTokens // 0),
            rank:            rank($state)
        }
    )
    | sort_by(.rank, -.statusUpdatedAt, .name) as $sessions
    | {
        generatedAt: $now,
        profiles: $profiles,
        counts: (
            {waiting: 0, error: 0, running: 0, working: 0, shell: 0, done: 0, unknown: 0}
            + ($sessions | group_by(.state) | map({key: .[0].state, value: length}) | from_entries)
            + {total: ($sessions | length)}
        ),
        sessions: $sessions
    }' --args "${extras[@]}"
