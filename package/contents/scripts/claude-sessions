#!/usr/bin/env -S fish --no-config
# Print one JSON document describing every agent session running right now:
# Claude Code, across every configured profile, and OMP (oh-my-pi).
#
# Claude Code keeps a registry of its own live sessions at
# <profile-dir>/sessions/<pid>.json, refreshed as the session changes state. The
# fields read here are `status` (one of busy/shell/idle/waiting), `waitingFor`,
# `needs`, `name`, `cwd` and `procStart`. Records are left behind when a session
# is killed rather than exiting cleanly, so every record is checked against /proc
# before it is reported: the process must still exist *and* its start time must
# match, which is what rules out a recycled pid.
#
# Two of the reported states are not in the registry at all and are worked out
# here (see __cs_running and __cs_error below):
#
#   running  a shell command or script is executing inside a busy session
#   error    an idle session whose last turn ended in an API error
#
# OMP keeps no registry at all, so its sessions are found the other way round:
# the process first, then the transcript it is writing, whose tail says what the
# session is doing (see the OMP section below).
#
# The widget polls this, so it stays cheap: record bodies and git metadata are
# read with fish builtins, and the whole batch is handed to a single jq. Only
# idle sessions pay for a transcript read, and only busy ones for a /proc walk.
# Each OMP session costs one `tail`, and all of them share one more jq.
#
# Environment:
#   CLAUDE_PROFILES          JSON array of {name, dir} to read, in order
#   CLAUDE_SESSIONS_OMP      0 to leave OMP out entirely: no /proc scan, nothing
#                            read, nothing run. Anything else, or unset, reads it.
#   CLAUDE_SESSIONS_PROC     root to look for <pid>/... under, default /proc
#   CLAUDE_SESSIONS_NO_ERROR set to skip the transcript scan entirely
#
# Exit status is 0 whenever a document was printed, including "nothing running".

# Ceilings, inherited by every process this starts. A run takes about 10 MB and
# a tenth of a CPU second, and still completes under a 128 MB address-space
# limit; these sit far above that, so they never bind on a run that is working,
# and stop one that is not - whatever it hit - long before the machine notices.
# Only ever lowered: a tighter limit already in force is kept, and a limit that
# cannot be set is simply not set.
function __cs_cap -a flag value
    set -l now (ulimit -S $flag)
    if test "$now" = unlimited; or test "$now" -gt $value 2>/dev/null
        ulimit -S $flag $value 2>/dev/null
    end
end
__cs_cap -v 1048576 # 1 GiB of address space per process
__cs_cap -t 30 # 30 seconds of CPU per process

set -l proc_root /proc
test -n "$CLAUDE_SESSIONS_PROC"; and set proc_root $CLAUDE_SESSIONS_PROC

# Which config directories to read, and what to call each one.
#
# Claude Code's own mechanism for a second account is $CLAUDE_CONFIG_DIR, which
# takes any path at all - so there is no set of directories to hardcode, and the
# widget hands over the list the user configured. Derived per run, never cached
# at load time: the test suite moves $HOME.
set -l profile_names
set -l profile_dirs
if test -n "$CLAUDE_PROFILES"
    # One jq, two lines per profile. Reading names and directories in separate
    # calls would double the only fork this parsing costs.
    set -l flat (echo $CLAUDE_PROFILES | jq -r '.[] | (.name // ""), (.dir // "")' 2>/dev/null)
    for i in (seq 1 2 (count $flat))
        set -l dir $flat[(math $i + 1)]
        test -n "$dir"; or continue
        set -a profile_names $flat[$i]
        set -a profile_dirs (string replace -r '^~' $HOME -- $dir)
    end
end
# Nothing configured: the directory Claude Code keeps its own account in, so
# running this by hand still shows something. Only that one - any other path is
# somebody's choice, and guessing at it is what this replaced.
# Only when nothing was handed over at all. An empty list is an answer - every
# account turned off, or the last one removed - and answering it with a
# directory nobody asked for is how "no accounts" became unreachable.
if test (count $profile_dirs) -eq 0 -a -z "$CLAUDE_PROFILES"
    set profile_names default
    set profile_dirs $HOME/.claude
end

# Is `pid` still the same process that wrote this record?
#
# Field 22 of /proc/<pid>/stat is the process start time in clock ticks, which is
# exactly what Claude Code stores as `procStart`. Field 2 is the executable name
# in parentheses and may itself contain spaces or parens, so the fields are counted
# from after the *last* ')' - where field 22 overall becomes field 20.
function __cs_alive -a proc_root pid want_start
    set -l statfile $proc_root/$pid/stat
    test -r $statfile; or return 1
    set -l line (string collect <$statfile 2>/dev/null)
    test -n "$line"; or return 1
    if test -z "$want_start"
        return 0 # older record with no start time recorded: existence is all we have
    end
    set -l fields (string split -n ' ' -- (string replace -r '^.*\)' '' -- $line))
    test (count $fields) -ge 20; or return 1
    test "$fields[20]" = "$want_start"
end

# Is a command running inside this session?
#
# Claude Code runs every Bash tool call as a direct child shell of its own
# process, so a child whose comm is a shell means "a command or script is
# executing". Its long-lived children are MCP servers (`npm exec …`, `node`),
# which are not shells, so the two never get confused. Subagents run inside the
# process and leave no trace here - they stay indistinguishable from thinking.
#
# Prints the command being run, when it can be recovered, and returns 1 when
# nothing is running.
function __cs_running -a proc_root pid
    # The main thread is where Claude Code's forks are attributed, and reading one
    # file beats globbing the dozens of task/ entries a node process has.
    set -l children_file $proc_root/$pid/task/$pid/children
    test -r $children_file; or return 1
    set -l kids (string split -n ' ' -- (string collect <$children_file 2>/dev/null))
    test (count $kids) -gt 0; or return 1

    for kid in $kids
        set -l comm (string trim -- (string collect <$proc_root/$kid/comm 2>/dev/null))
        contains -- "$comm" bash sh dash zsh fish ksh; or continue

        # Claude Code wraps each command as `… && eval '<command>' < /dev/null …`
        # after sourcing a shell snapshot. The eval'd text is the part worth
        # showing. `string split0` reads the NUL-separated argv without a fork.
        set -l argv_parts (string split0 <$proc_root/$kid/cmdline 2>/dev/null)
        set -l shown ""
        for part in $argv_parts
            set -l found (string match -gr "eval '(.*)" -- "$part")
            test -n "$found"; or continue
            set shown (string replace -r "' *<[^<]*\$" '' -- "$found")
            # The command was single-quoted for eval, so its own quotes arrive
            # as the '"'"' dance. Undo that, then flatten it onto one line.
            set shown (string replace -a "'\"'\"'" "'" -- "$shown")
            set shown (string replace -ar '\s+' ' ' -- "$shown")
            break
        end
        echo (string sub -l 120 -- (string trim -- "$shown"))
        return 0
    end
    return 1
end

# Did this session's last turn end in an API error?
#
# The registry has no error state - a session that fails goes back to `idle` -
# but the transcript records it, and unlike a live status the transcript is
# reliable here precisely because the session has stopped writing. The last
# assistant entry carries `isApiErrorMessage` and a message worth showing
# ("You've hit your session limit · resets 6:40pm", "Login expired · Please run
# /login"). Reading only the tail keeps the cost off the size of the file.
#
# Prints the message, and returns 1 when the last turn was fine.
function __cs_error -a profile_dir session_id
    test -n "$session_id"; or return 1
    test -z "$CLAUDE_SESSIONS_NO_ERROR"; or return 1

    set -l transcripts $profile_dir/projects/*/$session_id.jsonl
    set -l transcript
    for t in $transcripts
        test -f $t; and set transcript $t; and break
    end
    test -n "$transcript"; or return 1

    set -l tail_text (tail -c 32768 $transcript 2>/dev/null | string collect)
    string match -q '*"isApiErrorMessage":true*' -- "$tail_text"; or return 1

    # `fromjson?` drops the partial first line a byte-offset tail leaves behind.
    # -s matters: without it jq runs the filter per line, and "the last assistant
    # entry" silently becomes "any line that is an error".
    set -l message (printf '%s' $tail_text | jq -Rsr '
        [splits("\n") | fromjson? ]
        | map(select(.type == "assistant"))
        | last
        | select(.isApiErrorMessage == true)
        | (.message.content[0]?.text // "")
        | .[0:200]' 2>/dev/null | string collect | string trim)

    test -n "$message"; or return 1
    echo $message
end

# The git repository a session is sitting in, as "name" and "branch".
#
# Walks up for a .git rather than shelling out to git, which would be two more
# processes per session on every poll. Prints two lines: repository name, then
# branch (either may be empty).
function __cs_git -a dir
    set -l root ""
    set -l probe $dir
    # Bounded so a pathological path can't spin, and absolute paths are shallow.
    for i in (seq 40)
        test -n "$probe"; or break
        if test -e $probe/.git
            set root $probe
            break
        end
        set -l parent (path dirname $probe)
        test "$parent" = "$probe"; and break
        set probe $parent
    end

    if test -z "$root"
        echo ""
        echo ""
        return
    end

    # A worktree or submodule has .git as a file pointing at the real directory.
    set -l gitdir $root/.git
    if test -f $gitdir
        set -l pointer (string match -gr '^gitdir:\s*(.*)$' -- (string trim -- (string collect <$gitdir 2>/dev/null)))
        if test -n "$pointer"
            string match -qr '^/' -- $pointer; or set pointer $root/$pointer
            set gitdir $pointer
        end
    end

    set -l branch ""
    if test -r $gitdir/HEAD
        set -l head (string trim -- (string collect <$gitdir/HEAD 2>/dev/null))
        set branch (string match -gr '^ref: refs/heads/(.*)$' -- $head)
        if test -z "$branch"
            # Detached: show the short sha, which is what git itself would.
            string match -qr '^[0-9a-f]{7,40}$' -- $head; and set branch (string sub -l 7 -- $head)
        end
    end

    echo (path basename $root)
    echo $branch
end

# ─── OMP ────────────────────────────────────────────────────────────────────
#
# OMP writes no registry of live sessions, but every running session is a
# process, and that process holds its transcript open for as long as it writes
# to it. So the process table says which sessions are alive, its fd table says
# which transcript each one is, and the tail of that transcript says what it is
# doing - all three from files, like everything else here.

# Every OMP session process. The compiled binary runs as `omp`; an install run
# through bun or node shows that runtime's name with omp's script as the first
# argument. OMP's own helper processes (`omp __omp_worker_…`) share the name,
# and are dropped - none of them is a session.
#
# Every list below is globbed or read into a variable before it is used: an
# unmatched glob in an argument list is an error in fish, and `string` or `path`
# handed no arguments at all reads stdin instead - a hang, run from a terminal.
#
# And every read has a ceiling (`read -n`), so no file - a process's argv, a
# breadcrumb, a transcript with no newline in it - can make this hold more than
# a few kilobytes of it in memory.
function __cs_omp_pids -a proc_root
    set -l entries $proc_root/*
    test (count $entries) -gt 0; or return
    for pid in (string match -r '^[0-9]+$' -- (path basename $entries))
        # Checked first: a failed redirection is a warning fish prints wherever
        # stderr points, and a process can exit between the glob and the read.
        test -r $proc_root/$pid/comm; or continue
        set -l comm
        read -n 64 comm <$proc_root/$pid/comm; or continue
        contains -- "$comm" omp bun node; or continue
        # The first three arguments are all that is looked at: the helper's
        # marker comes first for the binary, second through bun or node.
        set -l a0
        set -l a1
        set -l a2
        test -r $proc_root/$pid/cmdline; or continue
        begin
            read -z -n 4096 a0
            read -z -n 4096 a1
            read -z -n 4096 a2
        end <$proc_root/$pid/cmdline
        test -n "$a0"; or continue
        string match -q -- '__omp_*' "$a1" "$a2"; and continue
        if test "$comm" != omp
            string match -qr -- '(^|/)omp$|/pi-coding-agent/' "$a1"; or continue
        end
        echo $pid
    end
end

# Only a file named the way OMP names a session's transcript is ever read as
# one: <timestamp>_<session-id>.jsonl, and a regular file at that.
function __cs_omp_is_transcript -a path
    string match -qr -- '/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9-]+Z_[^/]+\.jsonl$' "$path"
end

# The transcript an OMP process belongs to, printed as a path - which may not
# exist yet, for a session nobody has typed into.
#
# First choice is the one it has open. A session's transcript is named
# <timestamp>_<session-id>.jsonl; a subagent's, which the same process also
# holds open, is named after the agent - so the name alone tells them apart.
#
# A session OMP has not written yet holds nothing open, and nor does one that
# was resumed and has not written since. For those there is the breadcrumb OMP
# leaves per terminal, which is how its own `--continue` knows what was last
# open there: <agent-dir>/terminal-sessions/<tty>, holding the cwd and the
# transcript path. It is trusted only when its cwd is the process's own, since a
# terminal outlives the sessions run in it.
function __cs_omp_transcript -a proc_root pid cwd
    set -l best ""
    set -l best_mtime 0
    set -l fds $proc_root/$pid/fd/*
    set -l open
    test (count $fds) -gt 0; and set open (path resolve $fds)
    for f in $open
        __cs_omp_is_transcript $f; and test -f $f; or continue
        set -l m (path mtime -- $f)
        if test -z "$best"; or test "$m" -gt $best_mtime
            set best $f
            set best_mtime $m
        end
    end

    if test -z "$best"
        # OMP names a terminal after its tty, /dev/pts/4 becoming pts-4. `path
        # resolve` cannot be used here: it gives up on a link it cannot follow.
        set -l tty (readlink $proc_root/$pid/fd/0 2>/dev/null)
        string match -qr '^/dev/.' -- "$tty"; or return 1
        set -l terminal (string replace -a / - -- (string sub -s 6 -- $tty))
        for crumb in $HOME/.omp/agent/terminal-sessions/$terminal \
                $HOME/.omp/profiles/*/agent/terminal-sessions/$terminal
            test -f $crumb; or continue
            set -l crumb_cwd
            set -l crumb_file
            begin
                read -n 4096 crumb_cwd
                read -n 4096 crumb_file
            end <$crumb
            test "$crumb_cwd" = "$cwd"; or continue
            __cs_omp_is_transcript $crumb_file; or continue
            set -l m (path mtime -- $crumb)
            if test -z "$best"; or test "$m" -gt $best_mtime
                set best $crumb_file
                set best_mtime $m
            end
        end
    end

    test -n "$best"; or return 1
    echo $best
end

# When a process started, in clock ticks since boot: field 22 of its stat, which
# is also what Claude Code records as `procStart`. Field 2 is the executable
# name in parentheses and may hold spaces of its own, so fields are counted from
# after the last ')'. Prints nothing when the process is gone.
function __cs_start_ticks -a proc_root pid
    test -r $proc_root/$pid/stat; or return 1
    set -l line
    read -n 4096 line <$proc_root/$pid/stat
    set -l fields (string split -n ' ' -- (string replace -r '^.*\)' '' -- "$line"))
    string match -qr '^[0-9]+$' -- "$fields[20]"; or return 1
    echo $fields[20]
end

set -l bodies
set -l extras # index-aligned with $bodies: the fields worked out here
set -l present

for i in (seq (count $profile_dirs))
    set -l id $profile_names[$i]
    set -l dir $profile_dirs[$i]
    # The stock directory is the one place $CLAUDE_CONFIG_DIR must never be set
    # to, so a session from it gets a plain `claude --resume`.
    set -l is_default false
    test "$dir" = "$HOME/.claude"; and set is_default true
    test -d $dir; and set -a present $id

    for record in $dir/sessions/*.json
        test -f $record; or continue

        set -l pid (string replace -r '\.json$' '' -- (basename $record))
        string match -qr '^[0-9]+$' -- $pid; or continue

        # A torn record - Claude Code rewriting the file while this reads it - is
        # not valid JSON, and would fail the whole batch. Requiring a complete
        # object drops just that one record and keeps the rest of the panel.
        set -l body (string trim -- (string collect <$record 2>/dev/null))
        string match -qr '^\{.*\}$' -- "$body"; or continue

        set -l want_start (string match -gr '"procStart"\s*:\s*"([^"]*)"' -- "$body")
        __cs_alive $proc_root $pid "$want_start"; or continue

        set -l status_now (string match -gr '"status"\s*:\s*"([^"]*)"' -- "$body")
        set -l session_id (string match -gr '"sessionId"\s*:\s*"([^"]*)"' -- "$body")
        set -l cwd (string match -gr '"cwd"\s*:\s*"([^"]*)"' -- "$body")

        # Only busy sessions can be running a command, and only idle ones can be
        # sitting on a failed turn - so neither check runs where it can't apply.
        set -l overlay ""
        set -l detail ""
        if test "$status_now" = busy
            if set -l command (__cs_running $proc_root $pid)
                set overlay running
                set detail "$command"
            end
        else if test "$status_now" = idle
            if set -l message (__cs_error $dir "$session_id")
                set overlay error
                set detail "$message"
            end
        end

        set -l git_info (__cs_git "$cwd")

        set -a bodies "$body"
        # Every value carries a leading ":" because jq still reads an argument
        # beginning with "-" as an option, even after --args - and a command line
        # or an error message can quite reasonably start with one. jq strips it.
        set -a extras ":$id" ":$overlay" ":$detail" ":$git_info[1]" ":$git_info[2]" \
            ":$dir" ":$is_default"
    end
end

# OMP sessions join the same two lists, so they sort and count with the rest.
# Each transcript's tail becomes a registry-shaped record - `status` one of
# busy/idle/waiting/running/error, the reason in `detail` - so from here on a
# session is a session, whichever agent runs it.
#
# Switched off, none of this runs: not the /proc scan, not a read, not a
# process. Switched on, its cost has a ceiling whatever the machine is doing:
# at most 32 sessions, and per session one `tail` of at most 128 KiB plus a
# first line of at most 4 KiB - so the one jq they share never sees more than
# about 4 MiB. A command that cannot start, for want of memory or processes or
# anything else, costs the OMP rows of that one refresh and nothing more:
# nothing is retried, nothing is written, and the Claude Code rows still print.
set -l omp_pids
test "$CLAUDE_SESSIONS_OMP" != 0; and set omp_pids (__cs_omp_pids $proc_root)
set -l omp_max 32
test (count $omp_pids) -gt $omp_max; and set omp_pids $omp_pids[1..$omp_max]
if test (count $omp_pids) -gt 0
    set -l btime
    test -r $proc_root/stat; and set btime (string match -gr '^btime ([0-9]+)$' <$proc_root/stat)
    set -l omp_program (status dirname)/omp-sessions.jq

    set -l omp_files
    set -l omp_meta # seven per session, in the order the jq below reads them
    set -l omp_extras
    for pid in $omp_pids
        # Gone since the scan: nothing to report, and nothing to end later.
        set -l ticks (__cs_start_ticks $proc_root $pid); or continue
        set -l cwd (path resolve $proc_root/$pid/cwd)
        set -l file (__cs_omp_transcript $proc_root $pid "$cwd"); or continue
        set -l session_id (string match -gr '_([^_/]+)\.jsonl$' -- $file)

        # Transcripts live at <agent-dir>/sessions/<project>/<file>, unless
        # --session-dir put them somewhere else - in which case the directory
        # holding the file is all there is to say about where it came from.
        set -l sessions_dir (path dirname (path dirname $file))
        set -l agent_dir (path dirname $sessions_dir)
        test (path basename $sessions_dir) = sessions; or set agent_dir (path dirname $file)

        # The stock agent directory resumes with a plain `omp --resume`, and a
        # named profile (`omp --profile <name>`) lives under ~/.omp/profiles.
        set -l label OMP
        set -l omp_profile ""
        set -l is_default false
        if test "$agent_dir" = "$HOME/.omp/agent"
            set is_default true
        else if set omp_profile (string match -gr \
                '^'(string escape --style=regex -- $HOME)'/\.omp/profiles/([^/]+)/agent$' -- $agent_dir)
            set label "OMP $omp_profile"
        end

        # Epoch milliseconds: /proc/stat has the boot time, and USER_HZ is 100
        # on every architecture Linux exposes to userspace, so a tick is 10 ms.
        set -l started 0
        test -n "$btime"; and set started (math -s0 "($btime * 100 + $ticks) * 10")

        set -l git_info (__cs_git "$cwd")

        set -a omp_files $file
        set -a omp_meta ":$pid" ":$session_id" ":$cwd" ":$started" ":$file" \
            ":$omp_profile" ":$ticks"
        set -a omp_extras ":$label" ":" ":" ":$git_info[1]" ":$git_info[2]" \
            ":$agent_dir" ":$is_default"
    end

    # One stream for every session, read by omp-sessions.jq beside this script:
    # a record separator opens each, then the transcript's first line - the
    # title, kept in a fixed-width slot OMP rewrites in place - then its tail.
    # A separator cannot occur inside JSON text, so it is never mistaken for a
    # line of transcript.
    set -l records
    if test (count $omp_files) -gt 0
        set records (
            for f in $omp_files
                printf '\x1e\n'
                test -f $f; or continue
                set -l first
                read -n 4096 first <$f
                printf '%s\n' $first
                tail -c 131072 -- $f 2>/dev/null
                echo
            end | jq -ncR -f $omp_program --args $omp_meta 2>/dev/null)
    end

    # One record per session or none at all: the lists are paired by position,
    # so a jq that fell over halfway must not shift every record after it.
    if test (count $records) -eq (count $omp_files)
        set -a bodies $records
        set -a extras $omp_extras
    end
end

# fish concatenates a command substitution with an adjacent literal, so this is a
# millisecond stamp without relying on `date +%N`, which uutils coreutils - the
# default on this distro - does not accept a width for.
set -l now (date +%s)000

set -l present_json '[]'
test (count $present) -gt 0; and set present_json '["'(string join '","' $present)'"]'

# Record bodies arrive on stdin, one JSON object per record, in the same order as
# $extras - so a record's position is enough to pair it with what was worked out
# for it above.
printf '%s\n' $bodies | jq -n \
    --argjson now $now \
    --argjson profiles $present_json '
    def statusLabel($s):
        {waiting: "Waiting", running: "Running", busy: "Working",
         shell: "Shell", idle: "Done", error: "Error"}[$s]
        // (if ($s | length) > 0 then ($s[0:1] | ascii_upcase) + $s[1:] else "Unknown" end);
    def statusState($s):
        {waiting: "waiting", running: "running", busy: "working",
         shell: "shell", idle: "done", error: "error"}[$s] // "unknown";
    def rank($st):
        {waiting: 0, error: 1, running: 2, working: 3, shell: 4, done: 5}[$st] // 6;

    # Seven positional arguments per session, in the order the records were
    # read, each with the sentinel ":" the caller prefixed.
    def arg($i): ($ARGS.positional[$i] // ":") | .[1:];
    def extras($i): {
        profile:      (arg($i * 7)     | if . == "" then "work" else . end),
        overlay:       arg($i * 7 + 1),
        overlayDetail: arg($i * 7 + 2),
        repository:    arg($i * 7 + 3),
        branch:        arg($i * 7 + 4),
        profileDir:    arg($i * 7 + 5),
        profileDefault: (arg($i * 7 + 6) == "true")
    };

    [inputs] | to_entries | map(
        .value as $r
        | extras(.key) as $x
        # The two states worked out from /proc and the transcript stand in for the
        # registry status; everything downstream treats them alike.
        | (if ($x.overlay // "") != "" then $x.overlay else ($r.status // "") end) as $status
        | statusState($status) as $state
        | (($r.cwd // "") | split("/") | map(select(. != ""))) as $parts
        | {
            pid:             ($r.pid // 0),
            # Which tool runs the session, and with it how the session is
            # resumed: OMP records carry the transcript and named profile that
            # its resume command needs; Claude Code needs neither.
            agent:           ($r.agent // "claude"),
            sessionFile:     ($r.sessionFile // ""),
            ompProfile:      ($r.ompProfile // ""),
            # When the process started, in clock ticks since boot. Ending a
            # session checks it again first, so a pid that has since been
            # handed to some other process is never signalled.
            procStart:       (($r.procStart // "") | tostring),
            profile:         ($x.profile // "work"),
            profileDir:      ($x.profileDir // ""),
            profileDefault:  $x.profileDefault,
            name:            ($r.name // $parts[-1] // "session"),
            cwd:             ($r.cwd // ""),
            dir:             ($parts[-1] // "/"),
            repository:      ($x.repository // ""),
            branch:          ($x.branch // ""),
            sessionId:       ($r.sessionId // ""),
            kind:            ($r.kind // "interactive"),
            status:          $status,
            state:           $state,
            label:           statusLabel($status),
            detail:          (if ($x.overlayDetail // "") != "" then $x.overlayDetail
                              else ($r.needs // $r.waitingFor // $r.detail // "") end),
            startedAt:       ($r.startedAt // 0),
            statusUpdatedAt: ($r.statusUpdatedAt // $r.updatedAt // 0),
            version:         ($r.version // ""),
            rank:            rank($state)
        }
    )
    | sort_by(.rank, -.statusUpdatedAt, .name) as $sessions
    | {
        generatedAt: $now,
        profiles: $profiles,
        counts: (
            {waiting: 0, error: 0, running: 0, working: 0, shell: 0, done: 0, unknown: 0}
            + ($sessions | group_by(.state) | map({key: .[0].state, value: length}) | from_entries)
            + {total: ($sessions | length)}
        ),
        sessions: $sessions
    }' --args $extras
