#!/usr/bin/env -S fish --no-config
# Print each profile's plan usage, as one JSON document: every configured Claude
# Code account, then every Anthropic login OMP has.
#
# The percentages behind Claude Code's own /usage view come from an authenticated
# call to the endpoint below, with the bearer token Claude Code already stores per
# profile. Nothing is written and no token is ever logged: it is handed to curl
# through stdin rather than argv, so it does not show up in the process list.
#
# This is a Claude Code internal, not documented API. It is called at most once
# every few minutes - plan limits move slowly - and a failure is reported as a
# state rather than left to look like zero usage.
#
# OMP is asked rather than read: `omp usage --json` reports its own logins,
# refreshing their tokens as it goes, so the widget never touches OMP's
# credentials at all (see the OMP section below).
#
# Environment:
#   CLAUDE_PROFILES           JSON array of {name, dir} to read, in order
#   CLAUDE_USAGE_OMP          0 to leave OMP out: omp is not run at all
#   CLAUDE_USAGE_FIXTURE      read this file instead of calling the API (tests)
#   CLAUDE_USAGE_OMP_BIN      the omp to run, instead of the one on $PATH (tests)
#   CLAUDE_USAGE_SYSTEMD_RUN  the systemd-run to cap it with (tests)
#
# Exit status is 0 whenever a document was printed, including "nothing to show".

set -l endpoint https://api.anthropic.com/api/oauth/usage

# Which config directories to ask about, and what to call each one. Kept in step
# with claude-sessions on purpose: the two are read together and a profile the
# session list knows about but the usage footer does not would be a puzzle.
set -l profile_names
set -l profile_dirs
if test -n "$CLAUDE_PROFILES"
    set -l flat (echo $CLAUDE_PROFILES | jq -r '.[] | (.name // ""), (.dir // "")' 2>/dev/null)
    for i in (seq 1 2 (count $flat))
        set -l dir $flat[(math $i + 1)]
        test -n "$dir"; or continue
        set -a profile_names $flat[$i]
        set -a profile_dirs (string replace -r '^~' $HOME -- $dir)
    end
end
# Nothing configured: the directory Claude Code keeps its own account in, so
# running this by hand still shows something. Only that one - any other path is
# somebody's choice, and guessing at it is what this replaced.
# Only when nothing was handed over at all. An empty list is an answer - every
# account turned off, or the last one removed - and answering it with a
# directory nobody asked for is how "no accounts" became unreachable.
if test (count $profile_dirs) -eq 0 -a -z "$CLAUDE_PROFILES"
    set profile_names default
    set profile_dirs $HOME/.claude
end

# One profile's bars, or the reason there are none. Prints a JSON object.
function __cu_profile -a id name dir endpoint
    set -l credentials $dir/.credentials.json

    if not test -r $credentials
        jq -n --arg id $id --arg name $name '{id: $id, name: $name, state: "absent", bars: []}'
        return
    end

    set -l token (jq -r '.claudeAiOauth.accessToken // empty' $credentials 2>/dev/null)
    set -l expires (jq -r '.claudeAiOauth.expiresAt // empty' $credentials 2>/dev/null)

    if test -z "$token"
        jq -n --arg id $id --arg name $name '{id: $id, name: $name, state: "absent", bars: []}'
        return
    end

    # A token past its expiry would just come back 401. Saying so up front is
    # both faster and a better message than "the request failed".
    if test -n "$expires"
        set -l now_ms (date +%s)000
        if test "$expires" -lt "$now_ms" 2>/dev/null
            jq -n --arg id $id --arg name $name '{id: $id, name: $name, state: "expired", bars: []}'
            return
        end
    end

    set -l body
    if test -n "$CLAUDE_USAGE_FIXTURE"
        set body (string collect <$CLAUDE_USAGE_FIXTURE 2>/dev/null)
    else
        # --config on stdin keeps the token out of argv, where every other
        # process on the machine could read it.
        # --fail matters: without it a 429 or a 500 comes back as a JSON error
        # object, which has no `limits` key and so parsed cleanly as "this plan
        # has no limits" - a rate-limited request looked exactly like an empty
        # plan. With it, curl writes nothing and this reports the failure.
        set body (printf 'url = "%s"\nheader = "Authorization: Bearer %s"\nheader = "anthropic-beta: oauth-2025-04-20"\nheader = "Content-Type: application/json"\n' \
            $endpoint $token | curl --silent --show-error --fail --max-time 8 --config - 2>/dev/null | string collect)
    end

    if test -z "$body"
        jq -n --arg id $id --arg name $name '{id: $id, name: $name, state: "error", bars: []}'
        return
    end

    # `limits[]` already carries percent, severity and reset time per limit, and
    # names the model a scoped limit belongs to - so the bars on offer are
    # whatever the plan actually has, not a hardcoded three.
    echo $body | jq -c --arg id $id --arg name $name '
        # A body with no `limits` array at all is an error object, not a plan
        # without limits; only a real (possibly empty) array counts as ok.
        if (.limits | type) != "array" then {id: $id, name: $name, state: "error", bars: []} else
        def barLabel($l):
            if $l.kind == "session" then "Session"
            elif $l.kind == "weekly_all" then "Weekly"
            else ($l.scope.model.display_name // "Scoped") end;
        def barId($l):
            if $l.kind == "session" then "session"
            elif $l.kind == "weekly_all" then "weekly"
            else "scoped:" + ($l.scope.model.display_name // "other") end;

        {
            id: $id,
            name: $name,
            state: "ok",
            bars: [ (.limits // [])[]
                | select(.percent != null)
                | {
                    id: barId(.),
                    label: barLabel(.),
                    percent: (.percent // 0),
                    severity: (.severity // "normal"),
                    resetsAt: .resets_at,
                    active: (.is_active == true)
                  } ]
        } end' 2>/dev/null

    or jq -n --arg id $id --arg name $name '{id: $id, name: $name, state: "error", bars: []}'
end

set -l parts
for i in (seq (count $profile_dirs))
    set -a parts (__cu_profile $profile_dirs[$i] $profile_names[$i] $profile_dirs[$i] $endpoint)
end

# ─── OMP ────────────────────────────────────────────────────────────────────
#
# OMP keeps its logins per agent directory: ~/.omp/agent, and one per named
# profile under ~/.omp/profiles. Each is asked once, with `omp usage`, and each
# Anthropic account in its answer becomes a row named the way that agent
# directory's sessions are labelled - "OMP", or "OMP <profile>".
#
# omp is a 200 MB runtime, so it runs only inside a transient systemd scope
# that the kernel holds to 512 MB of memory, no swap and 64 tasks - if it ever
# wanted more, it alone is killed, inside its scope, and that account reads
# "couldn't get usage" until the next try. It is also stopped after 15 seconds,
# its output is read up to 1 MiB, and nothing is retried. Where there is no
# systemd user manager to hold it to that, omp is not run at all: the row says
# so instead of running something unbounded in the background.

function __cu_omp_row -a group name state
    jq -nc --arg id $group --arg name $name --arg state $state \
        '{id: $id, group: $id, agent: "omp", name: $name, state: $state, bars: []}'
end

function __cu_omp_bin
    # The panel's $PATH is the session's, which need not include where an
    # installer put omp - so the usual places are tried too.
    set -l candidates (command -s omp) $HOME/.local/bin/omp $HOME/.bun/bin/omp
    test -n "$CLAUDE_USAGE_OMP_BIN"; and set candidates $CLAUDE_USAGE_OMP_BIN
    for candidate in $candidates
        if test -x $candidate
            echo $candidate
            return
        end
    end
    return 1
end

if test "$CLAUDE_USAGE_OMP" != 0
    # Agent directories that exist, with the --profile each one needs.
    set -l groups
    set -l labels
    set -l profile_args
    if test -d $HOME/.omp/agent
        set -a groups omp:$HOME/.omp/agent
        set -a labels OMP
        set -a profile_args ""
    end
    set -l named $HOME/.omp/profiles/*/agent
    for dir in $named
        test -d $dir; or continue
        set -l profile (path basename (path dirname $dir))
        set -a groups omp:$dir
        set -a labels "OMP $profile"
        set -a profile_args $profile
    end

    set -l omp_bin (__cu_omp_bin)
    set -l systemd_run systemd-run
    test -n "$CLAUDE_USAGE_SYSTEMD_RUN"; and set systemd_run $CLAUDE_USAGE_SYSTEMD_RUN
    set -l capped false
    if command -q $systemd_run; and test -n "$XDG_RUNTIME_DIR" -a -S "$XDG_RUNTIME_DIR/systemd/private"
        set capped true
    end
    # Absolute, because of the `cd /` below.
    set -l program (path resolve (status dirname)/omp-usage.jq)

    # No omp installed means nothing to ask, whatever ~/.omp holds.
    if test (count $groups) -gt 0 -a -n "$omp_bin"
        # Away from any project directory, so no project's .omp settings apply.
        cd /
        for i in (seq (count $groups))
            if test $capped != true
                set -a parts (__cu_omp_row $groups[$i] $labels[$i] uncapped)
                continue
            end
            set -l profile_flag
            test -n "$profile_args[$i]"; and set profile_flag --profile $profile_args[$i]
            set -l report (timeout -k 2 15 $systemd_run --user --scope --quiet --collect \
                    -p MemoryMax=512M -p MemorySwapMax=0 -p TasksMax=64 -- \
                    $omp_bin $profile_flag usage --json --provider anthropic --no-extensions \
                    </dev/null 2>/dev/null | head -c 1048576 | string collect)
            set -l rows
            if test -n "$report"
                set rows (printf '%s' $report | jq -c --arg group $groups[$i] --arg name $labels[$i] \
                    -f $program 2>/dev/null)
                or set rows (__cu_omp_row $groups[$i] $labels[$i] error)
            else
                set rows (__cu_omp_row $groups[$i] $labels[$i] error)
            end
            set -a parts $rows
        end
    end
end

set -l now (date +%s)000
printf '%s\n' $parts | jq -s -c --argjson now $now '{fetchedAt: $now, profiles: .}'
