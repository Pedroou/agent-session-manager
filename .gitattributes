# The language bar should say what the widget is written in.
#
# The screenshot rig is tooling that produces docs/, not part of the thing
# anyone installs, and it was putting Python and shell on the front page of a
# QML project.
tools/** linguist-vendored

# The collectors have no extension; Linguist reads their bash shebang as Shell,
# which is what they are. The jq programs beside them are named outright.
package/contents/scripts/*.jq linguist-language=jq

# Generated, and enormous next to the source.
docs/screenshots/** linguist-documentation
